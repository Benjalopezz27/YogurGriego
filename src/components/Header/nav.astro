---
interface Props {
  mobile?: boolean;
}
const { mobile = false } = Astro.props;
const currentPath = Astro.url.pathname;

const links = [
  { href: "/",              label: "Inicio" },
  { href: "/productos",     label: "Productos" },
  { href: "/recetas",       label: "Recetas" },
  { href: "/nuestra-historia", label: "Nosotros" },
  { href: "/donde-comprar", label: "Dónde Comprar" },
  { href: "/mayorista",     label: "Mayoristas" },
];
---

{links.map(link => {
  // Normalize paths for comparison (handle trailing slashes)
  const normalizedPath = currentPath.endsWith("/") && currentPath !== "/" ? currentPath.slice(0, -1) : currentPath;
  const normalizedLink = link.href.endsWith("/") && link.href !== "/" ? link.href.slice(0, -1) : link.href;
  
  const isActive = normalizedPath === normalizedLink || 
                  (normalizedLink !== "/" && normalizedPath.startsWith(normalizedLink));

  return (
    <a
      href={link.href}
      aria-label={`Ir a ${link.label}`}
      aria-current={isActive ? "page" : undefined}
      class={`nav-link ${isActive ? "active" : ""} ${mobile ? "text-base py-1" : ""}`}
    >
      {link.label}
    </a>
  );
})}
