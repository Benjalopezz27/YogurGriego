---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header/header.astro";
import { getCollection } from "astro:content";

const productos = await getCollection("productos");
const destacados = productos.filter(p => p.data.destacado);
const otros = productos.filter(p => !p.data.destacado);
const ordered = [...destacados, ...otros];
---

<Layout
  title="Productos | Yogur Griego Artesanal Tucumán"
  description="Conocé toda nuestra línea de yogures griegos artesanales. Natural, con miel y nueces, con frutos del bosque. Sin conservantes, elaborados en Yerba Buena, Tucumán."
>
  <Header />

  <main class="pt-28 pb-20 px-6 min-h-screen">
    <div class="max-w-6xl mx-auto">

      <!-- Header -->
      <header class="text-center mb-16">
        <div class="badge mb-5 inline-flex">Nuestra Línea</div>
        <h1 class="section-heading mb-4">
          Nuestros <span>Productos</span>
        </h1>
        <div class="divider mx-auto"></div>
        <p class="mt-6 max-w-2xl mx-auto text-lg" style="color: var(--color-text-secondary);">
          Cada pote es elaborado artesanalmente con leche de calidad, fermentado durante 12 horas.
          Sin conservantes, sin colorantes.
        </p>
      </header>

      <!-- Product grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {ordered.map(producto => (
          <a
            href={`/productos/${producto.slug}`}
            class="group card block"
            aria-label={`Ver ${producto.data.nombre}`}
          >
            <!-- Product image -->
            <div class="relative overflow-hidden" style="height: 260px;">
              <img
                src={producto.data.imagen}
                alt={producto.data.nombre}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <div
                class="absolute inset-0"
                style="background: linear-gradient(to top, rgba(13,13,13,0.85) 0%, transparent 60%);"
              ></div>

              {producto.data.destacado && (
                <div
                  class="absolute top-4 left-4 px-3 py-1 rounded-full text-xs font-semibold"
                  style="background: var(--color-accent); color: #0D0D0D;"
                >
                  ⭐ Destacado
                </div>
              )}

              {!producto.data.disponible && (
                <div
                  class="absolute top-4 right-4 px-3 py-1 rounded-full text-xs font-semibold"
                  style="background: rgba(0,0,0,0.7); color: var(--color-text-muted);"
                >
                  Sin stock
                </div>
              )}

              <!-- Price on image -->
              <div class="absolute bottom-4 left-4">
                <span
                  class="text-3xl font-bold"
                  style="font-family: var(--font-serif); color: var(--color-accent);"
                >
                  ${producto.data.precio.toLocaleString("es-AR")}
                </span>
                <span class="text-sm ml-1" style="color: var(--color-text-secondary);">{producto.data.peso}</span>
              </div>
            </div>

            <!-- Content -->
            <div class="p-5">
              <div class="w-8 h-0.5 rounded-full mb-3 transition-all duration-300 group-hover:w-14" style="background: var(--color-accent);"></div>
              <h2
                class="font-semibold text-lg mb-2"
                style="font-family: var(--font-serif); color: var(--color-text-primary);"
              >
                {producto.data.nombre}
              </h2>
              <p class="text-sm mb-4" style="color: var(--color-text-secondary);">
                {producto.data.descripcionCorta}
              </p>

              <!-- Certs -->
              <div class="flex flex-wrap gap-2 mb-4">
                {producto.data.certificaciones.slice(0, 2).map(cert => (
                  <span class="badge badge-green text-xs">{cert}</span>
                ))}
              </div>

              <!-- Protein badge -->
              <div class="flex items-center gap-2 text-sm" style="color: var(--color-text-secondary);">
                <span style="color: var(--color-accent);">⚡</span>
                <span>{producto.data.proteinas}g de proteína por pote</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
</Layout>
