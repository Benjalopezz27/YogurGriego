---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header/header.astro";
import { getCollection, getEntry } from "astro:content";
import {
  Zap,
  Scale as ScaleIcon,
  Clock,
  ChevronRight,
  ArrowLeft,
  MessageCircle,
  Truck,
  ShieldCheck,
  Gift,
} from "lucide-astro";

export async function getStaticPaths() {
  const productos = await getCollection("productos");
  return productos.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const entry = await getEntry("productos", slug as string);
if (!entry) return Astro.redirect("/productos");

const { Content } = await entry.render();
const {
  nombre,
  descripcionCorta,
  precio,
  peso,
  proteinas,
  certificaciones,
  sabores,
  imagen,
  disponible,
  whatsappMsg,
} = entry.data;

const whatsappText = encodeURIComponent(
  whatsappMsg ?? `Hola! Quiero pedir: ${nombre} (${peso}) - $${precio}`,
);
const whatsappUrl = `https://wa.me/543814470386?text=${whatsappText}`;
---

<Layout
  title={`${nombre} | Yogur Griego Artesanal`}
  description={descripcionCorta}
  image={imagen}
>
  <Header />

  <main class="pt-28 pb-20 px-6 min-h-screen">
    <div class="max-w-5xl mx-auto">
      <!-- Breadcrumb -->
      <nav
        class="flex items-center gap-2 text-xs mb-10"
        style="color: var(--color-text-muted);"
      >
        <a href="/" class="hover:text-[var(--color-accent)] transition-colors"
          >Inicio</a
        >
        <ChevronRight class="w-3 h-3" />
        <a
          href="/productos"
          class="hover:text-[var(--color-accent)] transition-colors"
          >Productos</a
        >
        <ChevronRight class="w-3 h-3" />
        <span style="color: var(--color-text-secondary);">{nombre}</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">
        <!-- Product image -->
        <div class="gap-5 md:gap-10 flex flex-col">
          <div
            class="relative rounded-3xl overflow-hidden group"
            style="aspect-ratio: 1; border: 1px solid var(--color-border); background: var(--color-surface);"
          >
            <img
              src={imagen}
              alt={nombre}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="eager"
              transition:name={`product-${slug}`}
            />
            <div
              class="absolute inset-0"
              style="background: linear-gradient(to top, rgba(13,13,13,0.4) 0%, transparent 60%);"
            >
            </div>
          </div>
          <div
            class="rounded-3xl p-8 flex flex-col gap-6"
            style="background: var(--color-surface-2); border: 1px solid var(--color-border); box-shadow: var(--shadow-lg);"
          >
            <div class="flex items-baseline gap-2">
              <span
                class="text-5xl font-bold"
                style="font-family: var(--font-serif); color: var(--color-accent);"
              >
                ${precio.toLocaleString("es-AR")}
              </span>
              <span class="text-base" style="color: var(--color-text-muted);"
                >/ {peso}</span
              >
            </div>

            {
              disponible ? (
                <a
                  href={whatsappUrl}
                  target="_blank"
                  rel="noopener"
                  class="btn-whatsapp justify-center py-4 text-base gap-3"
                  aria-label={`Pedir ${nombre} por WhatsApp`}
                >
                  <MessageCircle class="w-5 h-5 " />
                  Pedir por WhatsApp
                </a>
              ) : (
                <button
                  disabled
                  class="btn-primary opacity-40 cursor-not-allowed justify-center py-4"
                >
                  Sin stock temporalmente
                </button>
              )
            }

            <div class="grid grid-cols-2 gap-4">
              <div
                class="flex items-center gap-2 text-xs"
                style="color: var(--color-text-muted);"
              >
                <Truck class="w-4 h-4" style="color: var(--color-accent);" />
                <span>Envíos en Tucumán</span>
              </div>
              <div
                class="flex items-center gap-2 text-xs"
                style="color: var(--color-text-muted);"
              >
                <ShieldCheck
                  class="w-4 h-4"
                  style="color: var(--color-accent);"
                />
                <span>Pagás al recibir</span>
              </div>
            </div>
          </div>
        </div>
        <!-- Magic Buy Box -->
        <div class="flex flex-col gap-8">
          <!-- Eyebrow -->
          <div class="flex flex-wrap gap-2">
            {
              certificaciones.map((cert) => (
                <span class="badge badge-green flex items-center gap-1.5">
                  <ShieldCheck class="w-3 h-3" />
                  {cert}
                </span>
              ))
            }
          </div>

          <!-- Title -->
          <div class="relative">
            <h1
              class="mb-2"
              style="font-family: var(--font-serif); font-size: clamp(2.5rem, 5vw, 3.5rem); color: var(--color-text-primary); line-height: 1;"
            >
              {nombre}
            </h1>
            <div class="divider"></div>
          </div>

          <!-- Description -->
          <p
            class="text-lg leading-relaxed"
            style="color: var(--color-text-secondary);"
          >
            {descripcionCorta}
          </p>

          <!-- Key stats -->
          <div
            class="grid grid-cols-3 gap-1 rounded-2xl p-6 mt-11"
            style="background: var(--color-surface); border: 1px solid var(--color-border);"
          >
            <div class="flex flex-col items-center text-center gap-2">
              <Zap class="w-5 h-5" style="color: var(--color-accent);" />
              <div>
                <p
                  class="text-xl font-bold"
                  style="font-family: var(--font-serif); color: var(--color-text-primary);"
                >
                  {proteinas}g
                </p>
                <p
                  class="text-[10px] uppercase tracking-widest"
                  style="color: var(--color-text-muted);"
                >
                  Proteína
                </p>
              </div>
            </div>
            <div
              class="flex flex-col items-center text-center gap-2"
              style="border-left: 1px solid var(--color-border); border-right: 1px solid var(--color-border);"
            >
              <ScaleIcon class="w-5 h-5" style="color: var(--color-accent);" />
              <div>
                <p
                  class="text-xl font-bold"
                  style="font-family: var(--font-serif); color: var(--color-text-primary);"
                >
                  {peso}
                </p>
                <p
                  class="text-[10px] uppercase tracking-widest"
                  style="color: var(--color-text-muted);"
                >
                  Contenido
                </p>
              </div>
            </div>
            <div class="flex flex-col items-center text-center gap-2">
              <Clock class="w-5 h-5" style="color: var(--color-accent);" />
              <div>
                <p
                  class="text-xl font-bold"
                  style="font-family: var(--font-serif); color: var(--color-text-primary);"
                >
                  12hs
                </p>
                <p
                  class="text-[10px] uppercase tracking-widest"
                  style="color: var(--color-text-muted);"
                >
                  Fermento
                </p>
              </div>
            </div>
          </div>

          <!-- Packs -->
          <div
            class="rounded-2xl p-5"
            style="background: var(--color-accent-soft); border: 1px solid rgba(200,169,110,0.2);"
          >
            <div class="flex items-center gap-2 mb-3">
              <Gift class="w-4 h-4" style="color: var(--color-accent);" />
              <p
                class="text-sm font-semibold"
                style="color: var(--color-accent);"
              >
                Pedís más, pagás menos
              </p>
            </div>
            <div
              class="grid grid-cols-3 gap-3 text-xs"
              style="color: var(--color-text-secondary);"
            >
              <div class="text-center p-2 rounded-lg bg-black/20">
                <p class="font-bold mb-1">x1</p><p>
                  ${precio.toLocaleString("es-AR")}
                </p>
              </div>
              <div class="text-center p-2 rounded-lg bg-black/20">
                <p class="font-bold mb-1">x3</p><p>
                  ${(precio * 2.7).toLocaleString("es-AR")}
                </p>
              </div>
              <div class="text-center p-2 rounded-lg bg-black/20">
                <p class="font-bold mb-1">x6</p><p>
                  ${(precio * 5).toLocaleString("es-AR")}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Detail Content -->
      <div
        class="mt-20 rounded-3xl p-10"
        style="background: var(--color-surface); border: 1px solid var(--color-border);"
      >
        <h2
          class="text-3xl font-semibold mb-8"
          style="font-family: var(--font-serif); color: var(--color-text-primary);"
        >
          Sobre nuestro {nombre}
        </h2>
        <div
          class="prose prose-invert prose-gold max-w-none prose-p:text-lg"
          style="color: var(--color-text-secondary);"
        >
          <Content />
        </div>
      </div>

      <!-- Bottom Navigation -->
      <div class="mt-12 flex justify-center">
        <a href="/productos" class="btn-outline group py-3 px-8 gap-3">
          <ArrowLeft
            class="w-4 h-4 transition-transform group-hover:-translate-x-1"
          />
          Ver todos los productos
        </a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .prose-gold :where(strong) {
    color: var(--color-accent);
  }
  .prose-gold :where(h3) {
    font-family: var(--font-serif);
    color: var(--color-text-primary);
    font-size: 1.5rem;
    margin-top: 2rem;
  }
</style>
