---
import ContactAside from "./contactAside.astro";
import ContactSteps from "./contactSteps.astro";
import ContactForm from "./contactForm.astro";
---

<section class="w-full px-6 py-20" id="contacto">
  <div class="max-w-6xl mx-auto">

    <!-- Section header -->
    <header class="text-center mb-16">
      <div class="badge mb-5 inline-flex">Pedí tu yogur</div>
      <h2 class="section-heading mb-4">
        ¿Cómo comprar nuestro <span>Yogur Griego?</span>
      </h2>
      <div class="divider mx-auto"></div>
      <p class="mt-6 max-w-xl mx-auto text-lg" style="color: var(--color-text-secondary);">
        Pedilo en pocos pasos y recibilo fresco en tu casa.
        <strong style="color: var(--color-accent);">Envíos en Yerba Buena y San Miguel de Tucumán.</strong>
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Main -->
      <section
        class="md:col-span-2 rounded-2xl p-8"
        style="background: var(--color-surface); border: 1px solid var(--color-border);"
      >
        <ContactSteps />
        <ContactForm />
      </section>

      <!-- Aside -->
      <ContactAside />
    </div>
  </div>
</section>
