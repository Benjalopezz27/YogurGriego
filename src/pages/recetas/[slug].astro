---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header/header.astro";
import { getCollection, getEntry } from "astro:content";

export async function getStaticPaths() {
  const recetas = await getCollection("recetas");
  return recetas.map(r => ({ params: { slug: r.slug } }));
}

const { slug } = Astro.params;
const entry = await getEntry("recetas", slug as string);
if (!entry) return Astro.redirect("/recetas");

const { Content } = await entry.render();
const { titulo, descripcion, tiempoPreparacion, porciones, dificultad, categoria, tagsDieteticos, ingredientes, imagenPrincipal } = entry.data;

const dificultadColor = { fácil: "#3A7A56", media: "#C8A96E", avanzada: "#C1440E" }[dificultad] ?? "#C8A96E";
---

<Layout title={`${titulo} | Recetas Yogur Griego`} description={descripcion} image={imagenPrincipal}>
  <Header />

  <main class="pt-28 pb-20 px-6 min-h-screen">
    <div class="max-w-4xl mx-auto">

      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm mb-8" style="color: var(--color-text-muted);">
        <a href="/" class="hover:opacity-70">Inicio</a>
        <span>/</span>
        <a href="/recetas" class="hover:opacity-70">Recetas</a>
        <span>/</span>
        <span style="color: var(--color-text-secondary);">{titulo}</span>
      </nav>

      <!-- Hero image -->
      <div class="relative rounded-2xl overflow-hidden mb-10" style="height: 380px; border: 1px solid var(--color-border);">
        <img src={imagenPrincipal} alt={titulo} class="w-full h-full object-cover" loading="eager" transition:name={`recipe-${slug}`} />
        <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(13,13,13,0.9) 0%, transparent 60%);"></div>
        <div class="absolute bottom-6 left-6 right-6">
          <div class="flex flex-wrap gap-2 mb-3">
            <span class="px-3 py-1 rounded-full text-xs font-semibold text-white" style={`background: ${dificultadColor}CC;`}>
              {dificultad}
            </span>
            <span class="px-3 py-1 rounded-full text-xs font-semibold text-white" style="background: rgba(0,0,0,0.5);">
              {categoria}
            </span>
          </div>
          <h1 style="font-family: var(--font-serif); font-size: clamp(1.8rem,5vw,3rem); color: var(--color-text-primary); line-height: 1.1;">
            {titulo}
          </h1>
        </div>
      </div>

      <!-- Stats bar -->
      <div
        class="grid grid-cols-3 gap-4 rounded-2xl p-5 mb-10"
        style="background: var(--color-surface); border: 1px solid var(--color-border);"
      >
        <div class="text-center">
          <p class="text-2xl font-bold mb-1" style="font-family: var(--font-serif); color: var(--color-accent);">⏱ {tiempoPreparacion}'</p>
          <p class="text-xs" style="color: var(--color-text-muted);">Preparación</p>
        </div>
        <div class="text-center" style="border-left: 1px solid var(--color-border); border-right: 1px solid var(--color-border);">
          <p class="text-2xl font-bold mb-1" style="font-family: var(--font-serif); color: var(--color-accent);">🍽 {porciones}</p>
          <p class="text-xs" style="color: var(--color-text-muted);">Porciones</p>
        </div>
        <div class="text-center">
          <p class="text-2xl font-bold mb-1" style={`font-family: var(--font-serif); color: ${dificultadColor};`}>{dificultad}</p>
          <p class="text-xs" style="color: var(--color-text-muted);">Dificultad</p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">

        <!-- Ingredients sidebar -->
        <div>
          <div class="rounded-2xl p-6 sticky top-28" style="background: var(--color-surface); border: 1px solid var(--color-border);">
            <h2 class="text-lg font-semibold mb-5" style="font-family: var(--font-serif); color: var(--color-text-primary);">
              Ingredientes
            </h2>
            <ul class="space-y-3">
              {ingredientes.map(ing => (
                <li class="flex items-start gap-3 text-sm" style="color: var(--color-text-secondary);">
                  <span class="mt-1.5 w-1.5 h-1.5 rounded-full flex-shrink-0" style="background: var(--color-accent);"></span>
                  {ing}
                </li>
              ))}
            </ul>

            {tagsDieteticos && (
              <div class="mt-6 pt-6" style="border-top: 1px solid var(--color-border);">
                <p class="text-xs font-semibold uppercase tracking-wider mb-3" style="color: var(--color-text-muted);">Apto para</p>
                <div class="flex flex-wrap gap-2">
                  {tagsDieteticos.map(tag => (
                    <span class="badge badge-green text-xs">{tag}</span>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>

        <!-- Recipe content -->
        <div class="lg:col-span-2">
          <div class="prose prose-invert max-w-none" style="color: var(--color-text-secondary);">
            <Content />
          </div>

          <!-- CTA -->
          <div
            class="mt-10 rounded-2xl p-6 text-center"
            style="background: var(--color-accent-soft); border: 1px solid rgba(200,169,110,0.2);"
          >
            <p class="font-semibold mb-1" style="color: var(--color-text-primary);">¿Querés el yogur para esta receta?</p>
            <p class="text-sm mb-4" style="color: var(--color-text-secondary);">Pedilo por WhatsApp con envío a domicilio en Yerba Buena.</p>
            <a
              href="https://wa.me/543814470386?text=Hola!%20Vi%20la%20receta%20de%20{encodeURIComponent(titulo)}%20y%20quiero%20pedir%20yogur%20griego"
              target="_blank"
              rel="noopener"
              class="btn-whatsapp inline-flex"
            >
              Pedir yogur griego ahora
            </a>
          </div>
        </div>
      </div>

      <div class="mt-10 text-center">
        <a href="/recetas" class="btn-outline">← Ver todas las recetas</a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .prose h2 { font-family: var(--font-serif); color: var(--color-text-primary); font-size: 1.5rem; margin-top: 2rem; margin-bottom: 1rem; }
  .prose h3 { font-family: var(--font-serif); color: var(--color-text-primary); font-size: 1.2rem; margin-top: 1.5rem; margin-bottom: 0.75rem; }
  .prose p { color: var(--color-text-secondary); line-height: 1.8; margin-bottom: 1rem; }
  .prose strong { color: var(--color-accent); }
  .prose ol { counter-reset: step; padding-left: 0; list-style: none; }
  .prose ol li { counter-increment: step; padding-left: 2.5rem; position: relative; margin-bottom: 1rem; color: var(--color-text-secondary); }
  .prose ol li::before { content: counter(step); position: absolute; left: 0; top: 0; width: 1.75rem; height: 1.75rem; border-radius: 50%; background: var(--color-accent-soft); border: 1px solid rgba(200,169,110,0.3); color: var(--color-accent); display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 600; }
  .prose ul li { margin-bottom: 0.5rem; color: var(--color-text-secondary); }
</style>
