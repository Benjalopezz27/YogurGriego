---
import Layout from "../layouts/Layout.astro";
import Carousel from "../components/Carousel.astro";
import Header from "../components/Header/header.astro";
import Beneficios from "../components/Benefits/beneficios.astro";
import Recipes from "../components/Recipes/Recipes.astro";
import Contact from "../components/Contact/Contact.astro";
import SectionContainer from "../components/SectionContainer.astro";
---

<Layout
  title="Yogur Griego Artesanal | Tucumán — Natural, Cremoso, Sin Conservantes"
  description="Yogur griego 100% artesanal elaborado en Yerba Buena, Tucumán. Cremoso, sin conservantes, 30g de proteína. Pedí por WhatsApp con envío a domicilio."
>
  <main>
    <!-- Hero -->
    <section id="inicio" class="w-full">
      <Header />
      <Carousel />
    </section>

    <!-- Benefits -->
    <section id="beneficios-section">
      <SectionContainer>
        <Beneficios />
      </SectionContainer>
    </section>

    <!-- Recipes -->
    <section id="recetas-section" style="background: var(--color-bg-secondary);">
      <SectionContainer>
        <Recipes />
      </SectionContainer>
    </section>

    <!-- Contact / Pedidos -->
    <section id="contacto">
      <SectionContainer>
        <Contact />
      </SectionContainer>
    </section>
  </main>
</Layout>
