---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header/header.astro";
import {
  MapPin,
  Truck,
  Store,
  CreditCard,
  Banknote,
  Phone,
  Smartphone,
  CheckCircle2,
  Navigation,
} from "lucide-astro";
---

<Layout
  title="Dónde Comprar | Yogur Griego Artesanal Tucumán"
  description="Encontrá dónde comprar nuestro yogur griego artesanal en Yerba Buena y San Miguel de Tucumán. Envío a domicilio o retiro en persona."
>
  <Header />

  <main class="pt-28 pb-20 px-6 min-h-screen">
    <div class="max-w-5xl mx-auto">
      <header class="text-center mb-16">
        <div class="badge mb-5 inline-flex items-center gap-2">
          <MapPin class="w-3 h-3" />
          Zona de Entrega
        </div>
        <h1 class="section-heading mb-4 text-center">
          ¿Cómo conseguir <span>tu Yogur?</span>
        </h1>
        <div class="divider mx-auto"></div>
        <p
          class="mt-6 max-w-xl mx-auto text-lg"
          style="color: var(--color-text-secondary);"
        >
          Llegamos a tu puerta en Yerba Buena y San Miguel de Tucumán con cadena
          de frío garantizada.
        </p>
      </header>

      <!-- Map Section (Full Width) -->
      <div class="mb-12">
        <div
          class="rounded-3xl overflow-hidden relative group"
          style="height: 400px; border: 1px solid var(--color-border); background: var(--color-surface);"
        >
          <iframe
            title="Mapa de zona de entrega - Yerba Buena y Tucumán"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d56973.32393655521!2d-65.29535800000001!3d-26.8134537!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9422433a2ee1bffb%3A0xc5d4083eee0d98b1!2sYerba%20Buena%2C%20Tucum%C3%A1n!5e0!3m2!1ses-419!2sar!4v1758581224444!5m2!1ses-419!2sar"
            width="100%"
            height="100%"
            style="border: 0; filter: grayscale(100%) invert(90%) contrast(110%);"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
          <div class="absolute bottom-6 left-6 right-6">
            <div
              class="bg-black/80 backdrop-blur-md rounded-2xl p-4 border border-white/5 inline-flex items-center gap-3"
            >
              <div
                class="w-10 h-10 rounded-full bg-[--color-accent-soft] flex items-center justify-center text-[--color-accent]"
              >
                <Navigation class="w-5 h-5" />
              </div>
              <div>
                <p
                  class="text-sm font-medium"
                  style="color: var(--color-text-primary);"
                >
                  Cobertura Total
                </p>
                <p class="text-xs" style="color: var(--color-text-muted);">
                  Yerba Buena & S.M. de Tucumán
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Info cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
        <div
          class="rounded-3xl p-8 transition-all hover:bg-white/[0.02]"
          style="background: var(--color-surface); border: 1px solid var(--color-border);"
        >
          <div class="flex items-center gap-3 mb-6">
            <div
              class="p-3 rounded-2xl bg-[--color-accent-soft] text-[--color-accent]"
            >
              <Truck class="w-6 h-6" />
            </div>
            <h2
              class="text-xl font-semibold"
              style="font-family: var(--font-serif); color: var(--color-text-primary);"
            >
              Envío a domicilio
            </h2>
          </div>
          <p
            class="text-base mb-6 leading-relaxed"
            style="color: var(--color-text-secondary);"
          >
            Repartos programados para asegurar la frescura. El yogur viaja
            refrigerado desde nuestra producción hasta tu mesa.
          </p>
          <div class="space-y-3">
            {
              [
                { label: "Yerba Buena", status: "Disponible" },
                { label: "San Miguel de Tucumán", status: "Disponible" },
                { label: "Tafí Viejo / Lomas", status: "Consultar" },
              ].map((item) => (
                <div class="flex justify-between items-center py-2 border-b border-white/5 last:border-0">
                  <span
                    class="text-sm font-medium"
                    style="color: var(--color-text-primary);"
                  >
                    {item.label}
                  </span>
                  <div class="flex items-center gap-1.5 text-xs">
                    {item.status === "Disponible" ? (
                      <CheckCircle2
                        class="w-3.5 h-3.5"
                        style="color: var(--color-accent);"
                      />
                    ) : null}
                    <span
                      style={
                        item.status === "Disponible"
                          ? "color: var(--color-accent);"
                          : "color: var(--color-text-muted);"
                      }
                    >
                      {item.status}
                    </span>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <div
          class="rounded-3xl p-8 transition-all hover:bg-white/[0.02]"
          style="background: var(--color-surface); border: 1px solid var(--color-border);"
        >
          <div class="flex items-center gap-3 mb-6">
            <div
              class="p-3 rounded-2xl bg-[--color-accent-soft] text-[--color-accent]"
            >
              <Store class="w-6 h-6" />
            </div>
            <h2
              class="text-xl font-semibold"
              style="font-family: var(--font-serif); color: var(--color-text-primary);"
            >
              Retiro en Producción
            </h2>
          </div>
          <p
            class="text-base mb-6 leading-relaxed"
            style="color: var(--color-text-secondary);"
          >
            Ubicados en Yerba Buena. Podés pasar por tu pedido coordinando
            previamente el horario por WhatsApp.
          </p>
          <div class="grid grid-cols-2 gap-4">
            <div class="rounded-2xl p-4 bg-black/20 border border-white/5">
              <p
                class="text-[10px] uppercase tracking-widest mb-1"
                style="color: var(--color-text-muted);"
              >
                Lun - Vie
              </p>
              <p
                class="text-sm font-semibold"
                style="color: var(--color-text-primary);"
              >
                9:00 - 15:00
              </p>
            </div>
            <div class="rounded-2xl p-4 bg-black/20 border border-white/5">
              <p
                class="text-[10px] uppercase tracking-widest mb-1"
                style="color: var(--color-text-muted);"
              >
                Sábados
              </p>
              <p
                class="text-sm font-semibold"
                style="color: var(--color-text-primary);"
              >
                9:00 - 18:00
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Payment and CTA -->
      <div class="flex flex-col gap-8 items-stretch">
        <div
          class="flex-1 rounded-3xl p-8"
          style="background: var(--color-surface-2); border: 1px solid var(--color-border);"
        >
          <div class="flex items-center justify-center gap-3 mb-6">
            <h2
              class="text-lg font-semibold"
              style="font-family: var(--font-serif); color: var(--color-text-primary);"
            >
              Métodos de pago
            </h2>
          </div>
          <div class="flex flex-wrap gap-3 mb-6 justify-center">
            {
              [
                { label: "Efectivo", icon: Banknote },
                { label: "Transferencia", icon: Smartphone },
                { label: "Mercado Pago", icon: Phone },
              ].map((item) => (
                <div
                  class="flex items-center gap-2 px-4 py-2 rounded-full text-xs font-medium bg-white/5 border border-white/10"
                  style="color: var(--color-text-secondary);"
                >
                  <item.icon class="w-3.5 h-3.5" />
                  {item.label}
                </div>
              ))
            }
          </div>
          <p
            class="text-xs text-center p-3 rounded-xl bg-[--color-accent-soft] border border-[--color-accent]/10"
            style="color: var(--color-accent);"
          >
            Pagás al momento de recibir o retirar tu pedido. ¡Cero fricción!
          </p>
        </div>

        <div class="flex-1 flex flex-col justify-center">
          <a
            href="https://wa.me/543814470386?text=Hola!%20Quiero%20coordinar%20una%20entrega%20o%20retiro"
            target="_blank"
            rel="noopener"
            class="btn-whatsapp justify-center py-8 text-lg gap-3 h-full"
            aria-label="Coordinar pedido por WhatsApp"
          >
            <Smartphone class="w-6 h-6" />
            Coordinar mi Pedido
          </a>
        </div>
      </div>
    </div>
  </main>
</Layout>
