---
const { title, icon: Icon, description } = Astro.props;
---

<div
  class="benefit-card group relative flex flex-col items-center text-center p-6 rounded-2xl cursor-pointer
         transition-all duration-500 ease-in-out overflow-hidden"
  style="background: var(--color-surface); border: 1px solid var(--color-border); min-height: 180px;"
  onclick="this.classList.toggle('is-expanded')"
>
  <!-- Icon container -->
  <div
    class="flex items-center justify-center w-14 h-14 rounded-xl mb-4 transition-all duration-300
           group-hover:scale-110"
    style="background: var(--color-accent-soft); border: 1px solid rgba(200,169,110,0.2);"
  >
    {(<Icon class="w-7 h-7" style="color: var(--color-accent);" />)}
  </div>

  <!-- Title -->
  <h3
    class="font-semibold text-base mb-2 transition-colors duration-300 group-hover:text-[var(--color-accent)]"
    style="font-family: var(--font-sans); color: var(--color-text-primary);"
  >
    {title}
  </h3>

  <!-- Description container -->
  <div class="description-wrapper overflow-hidden transition-all duration-500 max-h-0 opacity-0">
    <p class="text-sm mt-4 leading-relaxed" style="color: var(--color-text-secondary);">
      {description}
    </p>
  </div>

  <!-- Indicator icon -->
  <div class="mt-auto pt-4 transition-transform duration-300 transform" id="indicator">
    <svg class="w-4 h-4" style="color: var(--color-text-muted);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </div>

  <!-- Hover glow border effect -->
  <div
    class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
    style="border: 1px solid rgba(200,169,110,0.35); box-shadow: 0 0 24px rgba(200,169,110,0.08);"
  ></div>
</div>

<style>
  .benefit-card.is-expanded {
    border-color: var(--color-accent) !important;
    background: var(--color-surface-2) !important;
  }

  .benefit-card.is-expanded .description-wrapper {
    max-height: 200px; /* Suficiente para la descripción */
    opacity: 1;
    margin-bottom: 1rem;
  }

  .benefit-card.is-expanded #indicator {
    transform: rotate(180deg);
  }
</style>
