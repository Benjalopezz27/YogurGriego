---
import RecipesCard from "./RecipesCard.astro";
import { getCollection } from "astro:content";

const recetas = await getCollection("recetas");
const sorted = recetas.sort((a, b) => (b.data.featured ? 1 : 0) - (a.data.featured ? 1 : 0));
---

<section class="py-20 px-6" id="recetas">
  <div class="max-w-6xl mx-auto">

    <!-- Section header -->
    <header class="text-center mb-16">
      <div class="badge mb-5 inline-flex">Inspiración Culinaria</div>
      <h2 class="section-heading mb-4">
        Recetas con <span>Yogur Griego</span>
      </h2>
      <div class="divider mx-auto"></div>
      <p class="mt-6 max-w-2xl mx-auto text-lg" style="color: var(--color-text-secondary);">
        Explorá recetas que demuestran la versatilidad del yogur griego artesanal.
        Desde desayunos energéticos hasta postres de autor.
      </p>
    </header>

    <!-- Grid -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        sorted.map((receta) => (
          <RecipesCard
            title={receta.data.titulo}
            description={receta.data.descripcion}
            imageUrl={receta.data.imagenPrincipal}
            link={receta.data.link}
            categoria={receta.data.categoria}
            tiempoPreparacion={receta.data.tiempoPreparacion}
            dificultad={receta.data.dificultad}
          />
        ))
      }
    </div>

    <!-- CTA to full recipes page -->
    <div class="text-center mt-12">
      <a href="/recetas" class="btn-outline">
        Ver todas las recetas
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</section>
