---
const steps = [
  {
    number: "01",
    title: "Elegí la cantidad",
    description: "Seleccioná cuántos potes de 400g querés comprar. También tenemos packs de 3 y 6 unidades con precio especial.",
  },
  {
    number: "02",
    title: "Hacé tu pedido",
    description: "Mandanos un mensaje por WhatsApp indicando tu pedido y dirección. ¡Te respondemos al instante!",
  },
  {
    number: "03",
    title: "Recibilo en tu casa",
    description: "Entregamos con transporte refrigerado para asegurar la frescura máxima. También podés coordinar retiro.",
  },
];
---

<div class="mb-10">
  <h3
    class="text-xl font-semibold mb-8"
    style="font-family: var(--font-serif); color: var(--color-text-primary);"
  >
    Cómo comprar tu yogur griego
  </h3>

  <ol class="space-y-6">
    {steps.map((step) => (
      <li class="flex items-start gap-5">
        <div
          class="flex-shrink-0 w-12 h-12 rounded-xl flex items-center justify-center font-bold text-sm"
          style="background: var(--color-accent-soft); border: 1px solid rgba(200,169,110,0.3); color: var(--color-accent); font-family: var(--font-serif);"
        >
          {step.number}
        </div>
        <div class="pt-2">
          <p class="font-semibold mb-1" style="color: var(--color-text-primary);">{step.title}</p>
          <p class="text-sm" style="color: var(--color-text-secondary);">{step.description}</p>
        </div>
      </li>
    ))}
  </ol>
</div>
